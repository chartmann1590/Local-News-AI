# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
# Rename this file to .env and add your actual API key
OPENWEATHERMAP_API_KEY=your_api_key_here

# AI Fact-Checking (default: true)
# Enable AI-based verification to ensure rewritten articles maintain factual accuracy
# Set to "false" to disable fact-checking (faster but less accurate)
ENABLE_FACT_CHECKING=true

# Extra RSS/Atom feeds (comma-separated)
# These are appended to Google/Bing feeds and can help broaden coverage.
# Example default list below; customize for your region if desired.
FEED_EXTRA_URLS=https://rss.nytimes.com/services/xml/rss/nyt/US.xml,https://feeds.npr.org/1003/rss.xml,https://feeds.reuters.com/Reuters/domesticNews,https://www.theguardian.com/us-news/rss,https://feeds.foxnews.com/foxnews/national
