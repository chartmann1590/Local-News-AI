# OpenWeatherMap API Key
# Get your free API key at: https://openweathermap.org/api
# Rename this file to .env and add your actual API key
OPENWEATHERMAP_API_KEY=your_api_key_here

# AI Fact-Checking (default: true)
# Enable AI-based verification to ensure rewritten articles maintain factual accuracy
# Set to "false" to disable fact-checking (faster but less accurate)
ENABLE_FACT_CHECKING=true

# Extra RSS/Atom feeds (comma-separated)
# These are appended to Google/Bing feeds and can help broaden coverage.
# Example default list below; customize for your region if desired.
# Capital Region (Albany/Schenectady/Troy) local news examples
FEED_EXTRA_URLS=https://dailygazette.com/feed/,https://www.timesunion.com/local/?service=rss,https://www.troyrecord.com/feed/,https://spectrumlocalnews.com/nys/capital-region.rss,https://wnyt.com/feed/

# Broadcast polish (optional)
# Smooth transition duration between slides (seconds)
BROADCAST_TRANSITION_DURATION=0.5
# Enable subtle Ken Burns zoom effect on article images (1/true to enable)
BROADCAST_KEN_BURNS=1
# Total zoom amount across a clip (e.g., 0.03 = 3%)
BROADCAST_KEN_BURNS_ZOOM=0.03
# Optional background music (path inside container; default looks in /data/broadcasts/bgm.mp3)
# BROADCAST_BGM_PATH=/data/broadcasts/bgm.mp3
# Background music volume (0.0–1.0)
BROADCAST_BGM_VOLUME=0.12
# Narration fade in/out duration (seconds)
BROADCAST_AUDIO_FADE=0.5
